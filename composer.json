{
    "name": "contenir/contenir-resource",
    "description": "Contenir resources on contenir-db-model 2: attribute-mapped resource, collection and type entities, repositories, the page tree, page metadata, summaries and link normalisation. Framework neutral.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "resource",
        "metadata",
        "seo",
        "data-mapper"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "docs": "https://github.com/contenir/contenir-resource/tree/main/docs",
        "issues": "https://github.com/contenir/contenir-resource/issues",
        "source": "https://github.com/contenir/contenir-resource"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-db-model": "dev-main as 2.0.0-rc5",
        "contenir/contenir-metadata": "^2.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "contenir/contenir-preview": "0.1.x-dev",
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "laminas/laminas-servicemanager": "^3.22 || ^4.0",
        "php-db/phpdb-sqlite": "^0.2.0 || 0.3.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "suggest": {
        "contenir/contenir-preview": "Lets a CMS preview show a resource's unsaved values (see docs/previews.md)"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Resource\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Resource\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Resource\\Core\\ConfigProvider"
        },
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
